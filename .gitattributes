# Normalize line endings to LF in the repository and working tree,
# matching .editorconfig and Prettier, regardless of core.autocrlf.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
