---
import BaseLayout from './BaseLayout.astro';
import ProjectMediaShowcase from '../components/projects/ProjectMediaShowcase.astro';
import ProjectNavigation from '../components/projects/ProjectNavigation.astro';
import type { ProjectEntry } from '../utils/projects';

interface Props {
  project: ProjectEntry;
  prevProject?: ProjectEntry;
  nextProject?: ProjectEntry;
}

const { project, prevProject, nextProject } = Astro.props;
const { data } = project;

const getCategoryLabel = (cat: string) => {
  switch (cat) {
    case 'commercial':
      return 'Commercial Mobile';
    case 'educational-ar':
      return 'Augmented Reality';
    case 'hardware-web3':
      return 'Hardware & Web3';
    case 'architecture-showcase':
      return 'Architecture Showcase';
    case 'independent-game':
      return 'Gameplay Logic';
    default:
      return 'Project';
  }
};
---

<BaseLayout
  title={`${data.title} — Technical Case Study | Senior Unity Developer`}
  description={data.shortDescription}
  ogImage={data.coverImage}
>
  <article class="py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav
        class="mb-6 flex items-center gap-2 font-mono text-xs text-slate-400"
        aria-label="Breadcrumb"
      >
        <a href="/" class="hover:text-slate-200 transition-colors">
          Home
        </a>
        <span>/</span>
        <a href="/projects" class="hover:text-slate-200 transition-colors">
          Projects
        </a>
        <span>/</span>
        <span class="text-cyan-400 truncate">{data.title}</span>
      </nav>

      <!-- Case Study Header -->
      <header class="space-y-4 border-b border-slate-800 pb-8">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="rounded-full border border-cyan-500/30 bg-cyan-950/40 px-3 py-1 font-mono text-xs font-semibold text-cyan-300">
            {getCategoryLabel(data.category)}
          </span>
          <span class="font-mono text-xs text-slate-400">{data.platforms.join(' • ')}</span>
        </div>

        <h1 class="text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl lg:text-5xl">
          {data.title}
        </h1>

        <p class="text-lg text-slate-300 leading-relaxed sm:text-xl">{data.subtitle}</p>

        <!-- Executive Metadata Strip -->
        <div class="mt-6 grid grid-cols-1 gap-4 rounded-xl border border-slate-800 bg-slate-900/50 p-4 sm:grid-cols-3">
          <div>
            <span class="font-mono text-[10px] uppercase tracking-wider text-slate-400 block">
              My Role
            </span>
            <span class="font-medium text-slate-200 text-sm">{data.role}</span>
            {data.teamSize && (
              <span class="block font-mono text-[11px] text-slate-400 mt-0.5">
                Scope: {data.teamSize}
              </span>
            )}
          </div>

          <div>
            <span class="font-mono text-[10px] uppercase tracking-wider text-slate-400 block">
              Category
            </span>
            <span class="font-medium text-slate-200 text-sm">
              {getCategoryLabel(data.category)}
            </span>
          </div>

          <div>
            <span class="font-mono text-[10px] uppercase tracking-wider text-slate-400 block">
              Platforms
            </span>
            <span class="font-medium text-slate-200 text-sm">{data.platforms.join(', ')}</span>
          </div>
        </div>

        <!-- Verified Metrics & Store Links Strip -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
          {data.metrics && data.metrics.length > 0 && (
            <div class="flex flex-wrap gap-3">
              {data.metrics.map((metric) => (
                <div class="inline-flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-950/80 px-3 py-1.5 font-mono text-xs">
                  <span class="text-slate-400">{metric.label}:</span>
                  <span class="font-semibold text-emerald-400">{metric.value}</span>
                  {metric.verified && (
                    <span class="text-[10px] text-slate-400" title="Verified production data">
                      (Verified)
                    </span>
                  )}
                </div>
              ))}
            </div>
          )}

          {data.links && data.links.length > 0 && (
            <div class="flex flex-wrap items-center gap-2.5">
              {data.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-lg border border-cyan-500/40 bg-cyan-950/40 px-3.5 py-1.5 font-mono text-xs font-semibold text-cyan-300 transition-colors hover:border-cyan-400 hover:bg-cyan-900/50 hover:text-cyan-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
                >
                  {link.type === 'googleplay' && (
                    <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 0 1 0 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z" />
                    </svg>
                  )}
                  {link.type === 'appstore' && (
                    <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.33c.67-.81 1.12-1.94 1-3.08-.96.04-2.13.64-2.82 1.45-.61.7-.115 1.86-1.01 2.97 1.08.08 2.16-.53 2.83-1.34z" />
                    </svg>
                  )}
                  <span>{link.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- Visual Assets: Gameplay Video & Screenshot Gallery -->
      <ProjectMediaShowcase project={project} />

      <!-- Responsibility Categorization (Implemented vs Integrated vs Collaborative) -->
      {(data.implementedSystems.length > 0 ||
        data.integratedSystems.length > 0 ||
        data.collaborativeSystems.length > 0) && (
        <section class="mt-10 rounded-xl border border-slate-800 bg-slate-900/30 p-6 space-y-6">
          <h2 class="font-mono text-xs uppercase tracking-wider text-slate-400">
            Systems & Engineering Ownership Breakdown
          </h2>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {data.implementedSystems.length > 0 && (
              <div class="space-y-2">
                <span class="font-mono text-xs font-semibold text-emerald-400 flex items-center gap-1.5">
                  <span>✓</span> Personally Implemented
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300">
                  {data.implementedSystems.map((item) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-emerald-400 mt-0.5">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {data.integratedSystems.length > 0 && (
              <div class="space-y-2">
                <span class="font-mono text-xs font-semibold text-cyan-400 flex items-center gap-1.5">
                  <span>⚡</span> Integrated & Maintained
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300">
                  {data.integratedSystems.map((item) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-cyan-400 mt-0.5">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {data.collaborativeSystems.length > 0 && (
              <div class="space-y-2">
                <span class="font-mono text-xs font-semibold text-purple-400 flex items-center gap-1.5">
                  <span>👥</span> Collaborative Systems
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300">
                  {data.collaborativeSystems.map((item) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-purple-400 mt-0.5">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Specialized Highlights Callouts (Telemetry / Backend) -->
      {(data.analyticsHighlights.length > 0 || data.backendHighlights.length > 0) && (
        <section class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {data.analyticsHighlights.length > 0 && (
            <div class="rounded-xl border border-amber-500/20 bg-amber-950/10 p-5 space-y-2">
              <span class="font-mono text-xs font-semibold uppercase text-amber-400 block">
                📊 Telemetry & Data Infrastructure
              </span>
              <ul class="space-y-1.5 text-xs text-slate-300">
                {data.analyticsHighlights.map((point) => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-400 mt-0.5">▹</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {data.backendHighlights.length > 0 && (
            <div class="rounded-xl border border-cyan-500/20 bg-cyan-950/10 p-5 space-y-2">
              <span class="font-mono text-xs font-semibold uppercase text-cyan-400 block">
                🌐 Backend & REST API Communication
              </span>
              <ul class="space-y-1.5 text-xs text-slate-300">
                {data.backendHighlights.map((point) => (
                  <li class="flex items-start gap-2">
                    <span class="text-cyan-400 mt-0.5">▹</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}

      <!-- Technologies Used -->
      <section class="mt-8 pt-6 border-t border-slate-800">
        <span class="font-mono text-xs uppercase tracking-wider text-slate-400 block mb-3">
          Technologies & Libraries
        </span>
        <div class="flex flex-wrap gap-2 font-mono text-xs">
          {data.technologies.map((tech) => (
            <span class="rounded-md border border-slate-800 bg-slate-900/80 px-2.5 py-1 text-slate-200">
              {tech}
            </span>
          ))}
        </div>
      </section>

      <!-- Case Study Narrative Body -->
      <div class="mt-12 case-study-prose max-w-none border-t border-slate-800 pt-10">
        <slot />
      </div>

      <!-- Previous / Next Traversal -->
      <ProjectNavigation prevProject={prevProject} nextProject={nextProject} />
    </div>
  </article>
</BaseLayout>
