---
import { resolveLocale } from '../i18n';
import { getUI } from '../i18n/ui';

interface Props {
  targetId?: string;
}

const { targetId = 'main-content' } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
---

<a
  href={`#${targetId}`}
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-cyan-500 focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:font-bold focus:text-slate-950 focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-cyan-300"
>
  {ui.skipToContent}
</a>
