---
import { SITE_META } from '../data/site-meta';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const githubLink = SITE_META.socials.find((s) => s.platform === 'GitHub');
const linkedinLink = SITE_META.socials.find((s) => s.platform === 'LinkedIn');
---

<header class="sticky top-0 z-40 w-full border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md transition-all duration-200">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Title -->
    <a
      href="/"
      class="group flex items-center gap-3 font-mono text-sm tracking-tight transition-colors"
      aria-label="Home page"
    >
      <div class="relative flex h-8 w-8 shrink-0 overflow-hidden rounded-full border border-cyan-500/40 ring-1 ring-cyan-500/20 transition-all group-hover:border-cyan-400 group-hover:ring-cyan-400/40">
        <img
          src="/images/avatar.webp"
          alt="Igor Coseanic"
          width="32"
          height="32"
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
      <span class="flex flex-col">
        <span class="font-semibold text-slate-100 group-hover:text-cyan-400 transition-colors">
          Igor Coseanic
        </span>
        <span class="text-[10px] text-slate-400 tracking-normal">Senior Unity Developer</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex md:items-center md:gap-1" aria-label="Main Navigation">
      {SITE_META.nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`rounded-md px-3.5 py-1.5 text-sm font-medium transition-colors ${
              active
                ? 'bg-slate-800 text-cyan-400'
                : 'text-slate-300 hover:bg-slate-900 hover:text-slate-100'
            }`}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA & Socials -->
    <div class="hidden items-center gap-2.5 md:flex">
      {githubLink && (
        <a
          href={githubLink.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-800 bg-slate-900/80 text-slate-400 transition-all hover:border-cyan-500/50 hover:bg-slate-800 hover:text-cyan-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
          aria-label={githubLink.label}
          title={githubLink.label}
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            />
          </svg>
        </a>
      )}
      {linkedinLink && (
        <a
          href={linkedinLink.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-800 bg-slate-900/80 text-slate-400 transition-all hover:border-cyan-500/50 hover:bg-slate-800 hover:text-cyan-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
          aria-label={linkedinLink.label}
          title={linkedinLink.label}
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" />
          </svg>
        </a>
      )}
      <a
        href={`mailto:${SITE_META.email}`}
        class="inline-flex items-center justify-center rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-3.5 py-1.5 text-xs font-medium font-mono text-cyan-300 transition-all hover:border-cyan-400 hover:bg-cyan-500/20 hover:text-cyan-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
      >
        Get in Touch
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-slate-400 hover:bg-slate-900 hover:text-slate-200 focus:outline-none focus:ring-2 focus:ring-cyan-400 md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg
        id="icon-open"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
      <svg
        id="icon-close"
        class="hidden h-5 w-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div
    id="mobile-nav"
    class="hidden border-b border-slate-800 bg-slate-950 px-4 pt-2 pb-6 md:hidden"
  >
    <nav class="flex flex-col gap-1.5" aria-label="Mobile Navigation">
      {SITE_META.nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`rounded-md px-3 py-2 text-base font-medium transition-colors ${
              active
                ? 'bg-slate-800 text-cyan-400 font-semibold'
                : 'text-slate-300 hover:bg-slate-900 hover:text-slate-100'
            }`}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <div class="mt-4 pt-4 border-t border-slate-800 flex items-center gap-2.5">
        <a
          href={`mailto:${SITE_META.email}`}
          class="flex-1 flex items-center justify-center rounded-lg bg-cyan-500 px-4 py-2 font-mono text-sm font-semibold text-slate-950 transition hover:bg-cyan-400"
        >
          Get in Touch
        </a>
        {githubLink && (
          <a
            href={githubLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-800 bg-slate-900 text-slate-300 transition hover:border-cyan-500/50 hover:bg-slate-800 hover:text-cyan-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
            aria-label={githubLink.label}
            title={githubLink.label}
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              />
            </svg>
          </a>
        )}
        {linkedinLink && (
          <a
            href={linkedinLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-800 bg-slate-900 text-slate-300 transition hover:border-cyan-500/50 hover:bg-slate-800 hover:text-cyan-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
            aria-label={linkedinLink.label}
            title={linkedinLink.label}
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" />
            </svg>
          </a>
        )}
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // Close on escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileNav.classList.contains('hidden')) {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileNav.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.focus();
      }
    });
  }
</script>
