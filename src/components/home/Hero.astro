---
import { Image } from 'astro:assets';
import fujiBg from '../../assets/fuji-bg.jpg';
import { getSiteMeta } from '../../data/site-meta';
import { localizePath, resolveLocale } from '../../i18n';
import { getUI } from '../../i18n/ui';

const locale = resolveLocale(Astro.currentLocale);
const siteMeta = getSiteMeta(locale);
const ui = getUI(locale);
---

<section
  class="relative isolate overflow-hidden pt-12 pb-16 sm:pt-20 sm:pb-24 lg:pt-28 lg:pb-32"
  aria-labelledby="hero-heading"
>
  <!-- Subtle Mt. Fuji Background -->
  <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
    <Image
      src={fujiBg}
      alt=""
      class="h-full w-full object-cover object-[center_35%] opacity-25"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/50 via-slate-950/65 to-slate-950"></div>
  </div>

  <!-- Background Glow Accents -->
  <div
    class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute top-40 right-10 -z-10 h-72 w-72 rounded-full bg-emerald-500/5 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
      <!-- Left Column: Copy & CTAs -->
      <div class="space-y-6 lg:col-span-7">
        <!-- Role Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-950/40 px-3.5 py-1.5 font-mono text-xs text-cyan-300">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          <span>{siteMeta.status.label}</span>
        </div>

        <!-- Main Heading -->
        <h1
          id="hero-heading"
          class="text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl lg:text-5xl xl:text-6xl"
        >
          {ui.hero.headingPrefix}{' '}
          <span class="bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400 bg-clip-text text-transparent">
            {ui.hero.headingHighlight}
          </span>{' '}
          {ui.hero.headingSuffix}
        </h1>

        <!-- Description -->
        <p class="text-base text-slate-400 leading-relaxed sm:text-lg">{ui.hero.description}</p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href={localizePath('/projects', locale)}
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-cyan-500 px-5 py-3 font-mono text-sm font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
          >
            {ui.hero.exploreProjects}
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>

          <a
            href={localizePath('/cv', locale)}
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-700 bg-slate-900/80 px-5 py-3 font-mono text-sm font-medium text-slate-200 transition hover:border-slate-500 hover:text-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
          >
            {ui.hero.viewCv}
          </a>

          <a
            href="#contact"
            class="inline-flex items-center justify-center font-mono text-sm text-slate-400 transition hover:text-cyan-400 px-3 py-3"
          >
            {ui.hero.getInTouch}
          </a>
        </div>

        <!-- Core Technologies Strip -->
        <div class="pt-6 border-t border-slate-800/80">
          <p class="font-mono text-xs uppercase tracking-wider text-slate-400 mb-3">
            {ui.hero.competenciesTitle}
          </p>
          <div class="flex flex-wrap gap-2 text-xs font-mono">
            {ui.hero.competencies.map((comp) => {
              const badgeClasses =
                comp.variant === 'cyan'
                  ? 'border-cyan-500/30 bg-cyan-950/30 text-cyan-300'
                  : comp.variant === 'amber'
                    ? 'border-amber-500/30 bg-amber-950/30 text-amber-300'
                    : 'border-slate-800 bg-slate-900/60 text-slate-300';
              return (
                <span class={`rounded-md border px-2.5 py-1 ${badgeClasses}`}>{comp.text}</span>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Right Column: Developer Profile Card -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-sm">
          <!-- Ambient Glow Effect -->
          <div
            class="pointer-events-none absolute -inset-1 rounded-3xl bg-gradient-to-tr from-cyan-500/20 via-teal-500/10 to-transparent blur-xl"
            aria-hidden="true"
          ></div>

          <div class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/70 p-3 shadow-2xl backdrop-blur-sm transition hover:border-slate-700">
            <!-- Portrait Image -->
            <div class="relative aspect-[4/5] w-full overflow-hidden rounded-xl bg-slate-950">
              <img
                src="/images/profile-portrait.webp"
                alt={ui.hero.portraitAlt}
                width="480"
                height="600"
                class="h-full w-full object-cover object-top"
                loading="eager"
              />

              <!-- Top Floating Badge -->
              <div class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full border border-slate-800/80 bg-slate-950/80 px-2.5 py-1 font-mono text-[11px] text-emerald-400 backdrop-blur-md">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                <span>{ui.hero.yearsBadge}</span>
              </div>

              <!-- Bottom Gradient Overlay with Bio Info -->
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent p-4 pt-12">
                <h2 class="text-lg font-bold text-slate-100">{siteMeta.developerName}</h2>
                <p class="font-mono text-xs text-cyan-400">{ui.hero.cardRole}</p>
                <div class="mt-2 flex flex-wrap items-center gap-2 pt-2 border-t border-slate-800/80 text-[11px] font-mono text-slate-400">
                  <span>{ui.hero.cardMeta[0]}</span>
                  <span>•</span>
                  <span>{ui.hero.cardMeta[1]}</span>
                  <span>•</span>
                  <span>{ui.hero.cardMeta[2]}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
