---
import { resolveLocale } from '../../i18n';
import { getUI } from '../../i18n/ui';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
---

<section
  id="ai-engineering"
  class="border-t border-slate-800/80 bg-slate-900/30 py-14 lg:py-16"
  aria-labelledby="ai-spotlight-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start">
      <!-- Left Column: Concise Narrative -->
      <div class="space-y-3 lg:col-span-5">
        <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-slate-400">
          <span>{ui.aiSpotlight.eyebrow}</span>
        </div>

        <h2
          id="ai-spotlight-heading"
          class="text-2xl font-bold tracking-tight text-slate-100 sm:text-3xl"
        >
          {ui.aiSpotlight.heading}
        </h2>

        <p class="text-sm text-slate-300 leading-relaxed">{ui.aiSpotlight.description}</p>
      </div>

      <!-- Right Column: Compact 2x2 Grid -->
      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:col-span-7">
        {ui.aiSpotlight.workflows.map((item) => (
          <div class="rounded-lg border border-slate-800/80 bg-slate-950/70 p-4 transition hover:border-slate-700">
            <h3 class="font-semibold text-slate-100 text-sm">{item.title}</h3>
            <p class="mt-1.5 text-xs text-slate-400 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
