---
import { resolveLocale } from '../../i18n';
import { getUI } from '../../i18n/ui';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
---

<section
  id="expertise"
  class="border-t border-slate-800/80 bg-slate-950 py-20 lg:py-28"
  aria-labelledby="engineering-pillars-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-cyan-400">
        <span>{ui.pillars.eyebrow}</span>
      </div>
      <h2
        id="engineering-pillars-heading"
        class="mt-2 text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl"
      >
        {ui.pillars.heading}
      </h2>
      <p class="mt-2 text-slate-400 text-base leading-relaxed">{ui.pillars.description}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
      {ui.pillars.items.map((pillar) => (
        <div class="flex flex-col justify-between rounded-xl border border-slate-800/80 bg-slate-900/40 p-6 sm:p-8 transition hover:border-slate-700 hover:bg-slate-900/60">
          <div>
            <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
              <span class="font-mono text-xs font-semibold text-cyan-400">
                {ui.pillars.pillarLabel} {pillar.number}
              </span>
              <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
            </div>

            <h3 class="mt-4 text-xl font-bold tracking-tight text-slate-100">{pillar.title}</h3>

            <p class="mt-2 text-sm text-slate-300 leading-relaxed">{pillar.description}</p>

            <ul class="mt-5 space-y-2 text-xs text-slate-400">
              {pillar.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 mt-0.5 text-xs">▹</span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
