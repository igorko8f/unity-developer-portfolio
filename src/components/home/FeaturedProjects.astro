---
import { getFeaturedProjects } from '../../utils/projects';

const featuredProjects = await getFeaturedProjects();

// Separate the flagship Commercial Match-3 case study for the prominent Hero Spotlight, and the remaining 2 for the grid
const flagshipMatch3 = featuredProjects.find((p) => p.id === 'commercial-match-3');
const complementaryProjects = featuredProjects.filter((p) => p.id !== 'commercial-match-3');
---

<section id="projects" class="py-20 lg:py-28" aria-labelledby="featured-projects-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col justify-between gap-4 border-b border-slate-800 pb-8 sm:flex-row sm:items-end">
      <div>
        <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-cyan-400">
          <span>01 / Selected Work</span>
        </div>
        <h2
          id="featured-projects-heading"
          class="mt-2 text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl"
        >
          Featured Engineering Case Studies
        </h2>
        <p class="mt-2 max-w-2xl text-slate-400 text-base">
          Proven commercial mobile production, decoupled software architecture, and specialized
          technology integration.
        </p>
      </div>

      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 font-mono text-sm font-medium text-cyan-400 hover:text-cyan-300 transition-colors"
      >
        View All 5 Projects
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- 1. Primary Flagship Spotlight: Commercial Match-3 (NDA) -->
    {flagshipMatch3 && (
      <div class="mt-12">
        <div class="group relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 transition-all hover:border-slate-700 hover:bg-slate-900/90">
          <div class="grid grid-cols-1 gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:gap-12 lg:p-10">
            <!-- Left Info Column -->
            <div class="flex flex-col justify-between space-y-6 lg:col-span-7">
              <div class="space-y-4">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="rounded-full border border-emerald-500/30 bg-emerald-950/40 px-3 py-1 font-mono text-xs font-semibold text-emerald-400">
                    Commercial Mobile Flagship
                  </span>
                  <span class="rounded-full border border-cyan-500/30 bg-cyan-950/40 px-3 py-1 font-mono text-xs font-semibold text-cyan-300">
                    Team Lead
                  </span>
                  <span class="font-mono text-xs text-slate-400">
                    {flagshipMatch3.data.platforms.join(' • ')}
                  </span>
                </div>

                <h3 class="text-2xl font-bold tracking-tight text-slate-100 sm:text-3xl group-hover:text-cyan-300 transition-colors">
                  <a href={`/projects/${flagshipMatch3.id}`}>{flagshipMatch3.data.title}</a>
                </h3>

                <p class="text-slate-300 leading-relaxed text-base">
                  {flagshipMatch3.data.shortDescription}
                </p>

                <!-- Architectural Deep Dive Highlights -->
                <div class="mt-4 grid grid-cols-1 gap-3 rounded-xl border border-slate-800/80 bg-slate-950/60 p-4 sm:grid-cols-2">
                  <div class="space-y-1">
                    <span class="font-mono text-xs font-semibold uppercase text-amber-400">
                      ⚡ Offline Telemetry Pipeline
                    </span>
                    <p class="text-xs text-slate-400 leading-relaxed">
                      Custom analytics pipeline with cached queue synchronizing batches upon network
                      reconnection.
                    </p>
                  </div>

                  <div class="space-y-1">
                    <span class="font-mono text-xs font-semibold uppercase text-cyan-400">
                      🌐 REST API & Firebase Backend
                    </span>
                    <p class="text-xs text-slate-400 leading-relaxed">
                      Teams social messaging client, JWT auth, and Firebase RTDB/Firestore live
                      synchronization.
                    </p>
                  </div>

                  <div class="space-y-1">
                    <span class="font-mono text-xs font-semibold uppercase text-emerald-400">
                      🧩 Reusable Core Git Submodule
                    </span>
                    <p class="text-xs text-slate-400 leading-relaxed">
                      Extracted the Match-3 core into a standalone Git submodule, allowing other
                      company projects to integrate it and customize visuals.
                    </p>
                  </div>

                  <div class="space-y-1">
                    <span class="font-mono text-xs font-semibold uppercase text-purple-400">
                      🎮 2D-to-3D Gameplay Pipeline
                    </span>
                    <p class="text-xs text-slate-400 leading-relaxed">
                      Converted the core 2D gameplay pipeline to 3D and optimized performance and
                      rendering for mobile devices.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Technologies & CTA -->
              <div class="space-y-4 pt-4 border-t border-slate-800/80">
                <div class="flex flex-wrap gap-2 text-xs font-mono">
                  {flagshipMatch3.data.technologies.slice(0, 6).map((tech) => (
                    <span class="rounded-md border border-slate-800 bg-slate-950/80 px-2.5 py-1 text-slate-300">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  <a
                    href={`/projects/${flagshipMatch3.id}`}
                    class="inline-flex items-center gap-2 rounded-lg bg-cyan-500 px-5 py-2.5 font-mono text-sm font-semibold text-slate-950 transition hover:bg-cyan-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
                  >
                    Read Architecture Case Study
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                      />
                    </svg>
                  </a>

                  {flagshipMatch3.data.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-950/80 px-3.5 py-2.5 font-mono text-xs font-medium text-slate-200 transition hover:border-cyan-500/50 hover:text-cyan-300"
                    >
                      <span>{link.label}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right Visual Preview -->
            <div class="flex flex-col justify-between gap-4 lg:col-span-5">
              <div class="space-y-3">
                <a
                  href={`/projects/${flagshipMatch3.id}`}
                  class="group/media relative block overflow-hidden rounded-xl border border-slate-800 bg-slate-950"
                  aria-label={`View ${flagshipMatch3.data.title} visual showcase`}
                >
                  <img
                    src={flagshipMatch3.data.coverImage}
                    alt={flagshipMatch3.data.coverAlt}
                    loading="lazy"
                    decoding="async"
                    class="aspect-video w-full object-cover transition-transform duration-300 group-hover/media:scale-[1.03]"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent" />
                  <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between font-mono text-[11px]">
                    <span class="inline-flex items-center gap-1.5 rounded-md border border-cyan-500/40 bg-slate-950/85 px-2.5 py-1 font-semibold text-cyan-300 backdrop-blur-xs">
                      {flagshipMatch3.data.video?.src && flagshipMatch3.data.gallery.length > 0 ? (
                        <>
                          <span>▶</span>
                          <span>Gameplay Video + {flagshipMatch3.data.gallery.length} Screens</span>
                        </>
                      ) : flagshipMatch3.data.gallery.length > 0 ? (
                        <span>{flagshipMatch3.data.gallery.length} Visual Screens • NDA</span>
                      ) : (
                        <span>Architecture Case Study • NDA</span>
                      )}
                    </span>
                    <span class="rounded-md bg-slate-950/80 px-2 py-0.5 text-slate-300">
                      100k+ Downloads
                    </span>
                  </div>
                </a>

                {flagshipMatch3.data.gallery.filter(
                  (img) => img.src !== flagshipMatch3.data.coverImage,
                ).length > 0 && (
                  <div class="grid grid-cols-2 gap-3">
                    {flagshipMatch3.data.gallery
                      .filter((img) => img.src !== flagshipMatch3.data.coverImage)
                      .slice(0, 2)
                      .map((item) => (
                        <a
                          href={`/projects/${flagshipMatch3.id}`}
                          class="group/thumb relative block overflow-hidden rounded-lg border border-slate-800 bg-slate-950"
                        >
                          <img
                            src={item.src}
                            alt={item.alt}
                            loading="lazy"
                            decoding="async"
                            class="aspect-video w-full object-cover transition-transform duration-300 group-hover/thumb:scale-[1.04]"
                          />
                        </a>
                      ))}
                  </div>
                )}
              </div>

              {flagshipMatch3.data.metrics && flagshipMatch3.data.metrics.length > 0 && (
                <div class="grid grid-cols-3 gap-3 rounded-xl border border-slate-800/80 bg-slate-950/60 p-3.5 text-center">
                  {flagshipMatch3.data.metrics.slice(0, 3).map((metric) => (
                    <div>
                      <div class="font-mono text-sm font-bold text-slate-100">{metric.value}</div>
                      <div class="mt-0.5 font-mono text-[11px] text-slate-400">{metric.label}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- 2. Complementary Projects Grid (Component Ability System & BlueLight Inc.) -->
    <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2">
      {complementaryProjects.map((project) => {
        const videoCount =
          (project.data.video?.src ? 1 : 0) +
          (project.data.videos?.filter((item) => Boolean(item.src)).length ?? 0);
        const hasMedia =
          videoCount > 0 || (project.data.gallery && project.data.gallery.length > 0);
        const categoryBadge =
          project.data.category === 'architecture-showcase'
            ? {
                label: 'Architecture Showcase',
                classes: 'border-cyan-500/30 bg-cyan-950/40 text-cyan-300',
              }
            : project.data.category === 'hardware-web3'
              ? {
                  label: 'Hardware & Web3',
                  classes: 'border-amber-500/30 bg-amber-950/40 text-amber-300',
                }
              : {
                  label: 'Augmented Reality',
                  classes: 'border-purple-500/30 bg-purple-950/40 text-purple-300',
                };

        return (
          <div class="group flex flex-col justify-between overflow-hidden rounded-xl border border-slate-800 bg-slate-900/60 transition-all hover:border-slate-700 hover:bg-slate-900/80">
            {hasMedia && project.data.coverImage && (
              <a
                href={`/projects/${project.id}`}
                class="relative block aspect-video w-full overflow-hidden border-b border-slate-800 bg-slate-950"
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src={project.data.coverImage}
                  alt={project.data.coverAlt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-transparent to-transparent" />
                <div class="absolute bottom-2.5 left-3 flex flex-wrap items-center gap-1.5 font-mono text-[10px]">
                  {videoCount > 0 && (
                    <span class="inline-flex items-center gap-1 rounded border border-cyan-500/40 bg-slate-950/85 px-2 py-0.5 font-semibold text-cyan-300">
                      ▶ {videoCount === 1 ? 'Gameplay Video' : `${videoCount} Demo Videos`}
                    </span>
                  )}
                  {project.data.gallery && project.data.gallery.length > 0 && (
                    <span class="rounded border border-slate-700 bg-slate-950/85 px-2 py-0.5 text-slate-300">
                      {project.data.gallery.length} Screenshots
                    </span>
                  )}
                </div>
              </a>
            )}

            <div class="flex flex-1 flex-col justify-between p-6 sm:p-8">
              <div class="space-y-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span
                    class={`rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-semibold ${categoryBadge.classes}`}
                  >
                    {categoryBadge.label}
                  </span>
                  <span class="font-mono text-xs text-slate-400">
                    {project.data.platforms.join(' • ')}
                  </span>
                </div>

                <h3 class="text-xl font-bold tracking-tight text-slate-100 group-hover:text-cyan-300 transition-colors">
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h3>

                <p class="text-sm text-slate-300 leading-relaxed">
                  {project.data.shortDescription}
                </p>

                <!-- Architecture Highlights -->
                <ul class="space-y-1.5 pt-2 text-xs text-slate-400">
                  {project.data.architectureHighlights.slice(0, 2).map((highlight) => (
                    <li class="flex items-start gap-2">
                      <span class="text-cyan-400 mt-0.5">▹</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-800/80 space-y-4">
                <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                  {project.data.technologies.slice(0, 4).map((tech) => (
                    <span class="rounded bg-slate-950/80 px-2 py-0.5 text-slate-300 border border-slate-800">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="flex flex-wrap items-center justify-between gap-2">
                  <a
                    href={`/projects/${project.id}`}
                    class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors"
                  >
                    Read Technical Case Study →
                  </a>

                  {project.data.links.length > 0 && (
                    <div class="flex items-center gap-2">
                      {project.data.links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-mono text-xs text-slate-400 hover:text-slate-200 transition-colors"
                          aria-label={`${link.label} for ${project.data.title} (opens in new tab)`}
                        >
                          {link.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
