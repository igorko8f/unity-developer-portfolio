---
import { WORK_EXPERIENCE } from '../../data/experience';
---

<section
  id="experience"
  class="border-t border-slate-800/80 bg-slate-950 py-20 lg:py-28"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-4 border-b border-slate-800 pb-8 sm:flex-row sm:items-end">
      <div>
        <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-cyan-400">
          <span>04 / Career Progression</span>
        </div>
        <h2
          id="experience-heading"
          class="mt-2 text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl"
        >
          Professional Experience & Leadership
        </h2>
        <p class="mt-2 max-w-2xl text-slate-400 text-base">
          6+ years building commercial mobile titles, collaborating across teams, and leading
          technical initiatives.
        </p>
      </div>

      <a
        href="/experience"
        class="inline-flex items-center gap-1.5 font-mono text-sm font-medium text-cyan-400 hover:text-cyan-300 transition-colors"
      >
        View Full Career Timeline
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Experience Timeline List -->
    <div class="mt-12 space-y-8">
      {WORK_EXPERIENCE.map((exp) => (
        <div class="rounded-xl border border-slate-800/80 bg-slate-900/40 p-6 sm:p-8 transition hover:border-slate-700">
          <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
            <div>
              <h3 class="text-xl font-bold text-slate-100">{exp.role}</h3>
              <p class="font-mono text-sm text-cyan-400 mt-0.5">
                {exp.company} • {exp.location}
              </p>
            </div>

            <span class="inline-flex items-center rounded-full border border-slate-700 bg-slate-800/80 px-3 py-1 font-mono text-xs text-slate-300">
              {exp.period.start} — {exp.period.end}
            </span>
          </div>

          <p class="mt-4 text-sm text-slate-300 leading-relaxed">{exp.shortSummary}</p>

          <!-- Responsibilities highlights -->
          <ul class="mt-4 space-y-1.5 text-xs text-slate-400">
            {exp.responsibilities.slice(0, 3).map((resp) => (
              <li class="flex items-start gap-2">
                <span class="text-cyan-400 mt-0.5">▹</span>
                <span class="leading-relaxed">{resp}</span>
              </li>
            ))}
          </ul>

          <!-- Tech Pills -->
          <div class="mt-6 flex flex-wrap gap-2 pt-4 border-t border-slate-800/80 font-mono text-xs">
            {exp.technologiesUsed.map((tech) => (
              <span class="rounded bg-slate-950/80 px-2.5 py-1 text-slate-300 border border-slate-800">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
