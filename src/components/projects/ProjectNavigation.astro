---
import { getProjectSlug, type ProjectEntry } from '../../utils/projects';
import { localizePath, resolveLocale } from '../../i18n';
import { getUI } from '../../i18n/ui';

interface Props {
  prevProject?: ProjectEntry;
  nextProject?: ProjectEntry;
}

const { prevProject, nextProject } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
const allProjectsHref = localizePath('/projects', locale);
---

<nav
  class="mt-16 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-6 font-mono text-sm"
  aria-label={ui.projectCommon.projectNavAria}
>
  <div>
    {prevProject ? (
      <a
        href={localizePath(`/projects/${getProjectSlug(prevProject)}`, locale)}
        class="group flex flex-col items-start gap-1 text-slate-400 hover:text-cyan-400 transition-colors"
      >
        <span class="text-xs text-slate-400 flex items-center gap-1">
          <span class="transition-transform group-hover:-translate-x-1">←</span>
          {ui.projectCommon.previousCaseStudy}
        </span>
        <span class="font-sans font-semibold text-slate-200 group-hover:text-cyan-300">
          {prevProject.data.title}
        </span>
      </a>
    ) : (
      <a
        href={allProjectsHref}
        class="text-xs text-slate-400 hover:text-cyan-400 transition-colors"
      >
        ← {ui.projectCommon.backToAllProjects}
      </a>
    )}
  </div>

  <div class="hidden sm:block">
    <a
      href={allProjectsHref}
      class="rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs text-slate-400 hover:border-slate-700 hover:text-slate-200 transition"
    >
      {ui.projectCommon.allProjects}
    </a>
  </div>

  <div class="w-full sm:w-auto text-left sm:text-right">
    {nextProject ? (
      <a
        href={localizePath(`/projects/${getProjectSlug(nextProject)}`, locale)}
        class="group flex flex-col items-start sm:items-end gap-1 text-slate-400 hover:text-cyan-400 transition-colors"
      >
        <span class="text-xs text-slate-400 flex items-center gap-1">
          {ui.projectCommon.nextCaseStudy}
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </span>
        <span class="font-sans font-semibold text-slate-200 group-hover:text-cyan-300">
          {nextProject.data.title}
        </span>
      </a>
    ) : (
      <a
        href={allProjectsHref}
        class="text-xs text-slate-400 hover:text-cyan-400 transition-colors"
      >
        {ui.projectCommon.backToAllProjects} →
      </a>
    )}
  </div>
</nav>
