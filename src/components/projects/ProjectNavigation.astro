---
import type { ProjectEntry } from '../../utils/projects';

interface Props {
  prevProject?: ProjectEntry;
  nextProject?: ProjectEntry;
}

const { prevProject, nextProject } = Astro.props;
---

<nav
  class="mt-16 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-6 font-mono text-sm"
  aria-label="Project Navigation"
>
  <div>
    {prevProject ? (
      <a
        href={`/projects/${prevProject.id}`}
        class="group flex flex-col items-start gap-1 text-slate-400 hover:text-cyan-400 transition-colors"
      >
        <span class="text-xs text-slate-400 flex items-center gap-1">
          <span class="transition-transform group-hover:-translate-x-1">←</span>
          Previous Case Study
        </span>
        <span class="font-sans font-semibold text-slate-200 group-hover:text-cyan-300">
          {prevProject.data.title}
        </span>
      </a>
    ) : (
      <a href="/projects" class="text-xs text-slate-400 hover:text-cyan-400 transition-colors">
        ← Back to All Projects
      </a>
    )}
  </div>

  <div class="hidden sm:block">
    <a
      href="/projects"
      class="rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs text-slate-400 hover:border-slate-700 hover:text-slate-200 transition"
    >
      All Projects
    </a>
  </div>

  <div class="text-right">
    {nextProject ? (
      <a
        href={`/projects/${nextProject.id}`}
        class="group flex flex-col items-end gap-1 text-slate-400 hover:text-cyan-400 transition-colors"
      >
        <span class="text-xs text-slate-400 flex items-center gap-1">
          Next Case Study
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </span>
        <span class="font-sans font-semibold text-slate-200 group-hover:text-cyan-300">
          {nextProject.data.title}
        </span>
      </a>
    ) : (
      <a href="/projects" class="text-xs text-slate-400 hover:text-cyan-400 transition-colors">
        Back to All Projects →
      </a>
    )}
  </div>
</nav>
