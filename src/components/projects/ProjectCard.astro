---
import type { ProjectEntry } from '../../utils/projects';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data, id } = project;
const videoCount =
  (data.video?.src ? 1 : 0) + (data.videos?.filter((item) => Boolean(item.src)).length ?? 0);
const hasMedia = videoCount > 0 || (data.gallery && data.gallery.length > 0);

const getCategoryLabel = (cat: string) => {
  switch (cat) {
    case 'commercial':
      return 'Commercial Mobile';
    case 'educational-ar':
      return 'Augmented Reality';
    case 'hardware-web3':
      return 'Hardware & Web3';
    case 'architecture-showcase':
      return 'Architecture Showcase';
    case 'independent-game':
      return 'Gameplay Logic';
    default:
      return 'Project';
  }
};

const getCategoryColor = (cat: string) => {
  switch (cat) {
    case 'commercial':
      return 'border-emerald-500/30 bg-emerald-950/40 text-emerald-300';
    case 'architecture-showcase':
      return 'border-cyan-500/30 bg-cyan-950/40 text-cyan-300';
    case 'educational-ar':
      return 'border-purple-500/30 bg-purple-950/40 text-purple-300';
    case 'hardware-web3':
      return 'border-amber-500/30 bg-amber-950/40 text-amber-300';
    default:
      return 'border-slate-700 bg-slate-900 text-slate-300';
  }
};
---

<article class="group flex flex-col justify-between rounded-xl border border-slate-800 bg-slate-900/50 p-6 sm:p-7 transition-all duration-200 hover:border-slate-700 hover:bg-slate-900/80">
  <div class="space-y-4">
    {hasMedia && (
      <a
        href={`/projects/${id}`}
        class="relative mb-2 block overflow-hidden rounded-lg border border-slate-800 bg-slate-950"
        aria-label={`View ${data.title} case study and media`}
      >
        <img
          src={data.coverImage}
          alt={data.coverAlt}
          loading="lazy"
          decoding="async"
          class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent" />
        <div class="absolute bottom-2.5 left-2.5 flex flex-wrap items-center gap-1.5 font-mono text-[10px]">
          {videoCount > 0 && (
            <span class="rounded border border-cyan-500/40 bg-slate-950/85 px-2 py-0.5 font-semibold text-cyan-300">
              ▶ {videoCount === 1 ? 'Gameplay Video' : `${videoCount} Demo Videos`}
            </span>
          )}
          {data.gallery && data.gallery.length > 0 && (
            <span class="rounded border border-slate-700 bg-slate-950/85 px-2 py-0.5 text-slate-200">
              {data.gallery.length} Screenshots
            </span>
          )}
        </div>
      </a>
    )}

    <!-- Meta row: Category pill + Platforms -->
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span
        class={`inline-flex items-center rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-semibold ${getCategoryColor(data.category)}`}
      >
        {getCategoryLabel(data.category)}
      </span>

      <span class="font-mono text-xs text-slate-400">{data.platforms.join(' • ')}</span>
    </div>

    <!-- Title & Subtitle -->
    <div>
      <h3 class="text-xl font-bold tracking-tight text-slate-100 group-hover:text-cyan-300 transition-colors">
        <a href={`/projects/${id}`} class="focus:outline-none focus:underline">
          {data.title}
        </a>
      </h3>
      <p class="mt-1 font-mono text-xs text-slate-400">{data.role}</p>
    </div>

    <!-- Short Description -->
    <p class="text-sm text-slate-300 leading-relaxed">{data.shortDescription}</p>

    <!-- Key Highlights / Architecture Points -->
    {data.architectureHighlights.length > 0 && (
      <div class="pt-2">
        <span class="font-mono text-[10px] uppercase tracking-wider text-slate-400 block mb-1">
          Engineering Highlights
        </span>
        <ul class="space-y-1 text-xs text-slate-400">
          {data.architectureHighlights.slice(0, 2).map((highlight) => (
            <li class="flex items-start gap-1.5">
              <span class="text-cyan-400 mt-0.5">▹</span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Bottom: Tech pills + Action -->
  <div class="mt-6 pt-4 border-t border-slate-800/80 space-y-4">
    <div class="flex flex-wrap gap-1.5 font-mono text-xs">
      {data.technologies.slice(0, 4).map((tech) => (
        <span class="rounded bg-slate-950/80 px-2 py-0.5 text-slate-300 border border-slate-800">
          {tech}
        </span>
      ))}
      {data.technologies.length > 4 && (
        <span class="rounded bg-slate-950/80 px-1.5 py-0.5 text-slate-400 border border-slate-800/60 text-[11px]">
          +{data.technologies.length - 4}
        </span>
      )}
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
      <a
        href={`/projects/${id}`}
        class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors"
      >
        <span>Explore Case Study</span>
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      {data.links && data.links.length > 0 && (
        <div class="flex flex-wrap items-center gap-3">
          {data.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[11px] text-slate-400 hover:text-cyan-300 transition-colors"
            >
              {link.label} ↗
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>
