---
import type { ProjectEntry } from '../../utils/projects';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;

const videos = [
  ...(data.video?.src ? [data.video] : []),
  ...(data.videos ?? []).filter((item) => Boolean(item.src)),
];
const hasVideo = videos.length > 0;
const galleryItems = data.gallery ?? [];
const portraitItems = galleryItems.filter((item) => item.aspect === 'portrait');
const landscapeItems = galleryItems.filter((item) => item.aspect !== 'portrait');
const hasGallery = galleryItems.length > 0;
---

{(hasVideo || hasGallery) && (
  <section class="mt-10 space-y-8" aria-labelledby="media-showcase-heading">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
      <h2
        id="media-showcase-heading"
        class="font-mono text-xs uppercase tracking-wider text-cyan-400 flex items-center gap-2"
      >
        <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
        <span>Gameplay Video & Visual Showcase</span>
      </h2>
      <span class="font-mono text-[11px] text-slate-400">
        {hasVideo && (videos.length === 1 ? '1 Gameplay Video' : `${videos.length} Demo Videos`)}
        {hasVideo && hasGallery && ' • '}
        {hasGallery && `${galleryItems.length} Screenshots`}
      </span>
    </div>

    {/* 1. Featured Gameplay & Demo Video Players */}
    {hasVideo && (
      <div class="space-y-6">
        {videos.map((videoItem) => (
          <figure class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-950/90 shadow-xl">
            <div class="flex items-center justify-between border-b border-slate-800/80 bg-slate-900/70 px-4 py-2.5 font-mono text-xs">
              <div class="flex items-center gap-2 text-slate-200">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                <span class="font-semibold truncate">
                  {videoItem.title ?? `${data.title} — Gameplay Showcase`}
                </span>
              </div>
              <span class="rounded border border-slate-700 bg-slate-950 px-2 py-0.5 text-[10px] text-cyan-300">
                HD MP4
              </span>
            </div>

            <div class="relative aspect-video w-full bg-slate-950">
              <video
                class="h-full w-full object-contain"
                controls
                preload="metadata"
                playsinline
                poster={videoItem.poster ?? data.coverImage}
              >
                <source src={videoItem.src} type="video/mp4" />
                Your browser does not support HTML5 video playback.
              </video>
            </div>

            {videoItem.caption && (
              <figcaption class="border-t border-slate-800/80 bg-slate-900/40 px-4 py-3 font-mono text-xs text-slate-400">
                {videoItem.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    )}

    {/* 2. Portrait Mobile Gameplay Screenshots Grid */}
    {portraitItems.length > 0 && (
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="font-mono text-xs uppercase tracking-wider text-slate-400">
            Mobile Gameplay & LiveOps Screens
          </h3>
          <span class="font-mono text-[11px] text-slate-400">Click any screen to enlarge</span>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          {portraitItems.map((item) => (
            <figure class="group relative flex flex-col overflow-hidden rounded-xl border border-slate-800 bg-slate-900/50 transition-all hover:border-cyan-500/50 hover:bg-slate-900/90">
              <button
                type="button"
                class="media-lightbox-trigger relative block w-full overflow-hidden bg-slate-950 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
                data-full-src={item.src}
                data-full-alt={item.alt}
                data-full-caption={item.caption ?? item.alt}
                aria-label={`View full size image: ${item.caption ?? item.alt}`}
              >
                <img
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[9/19.5] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
                <span class="pointer-events-none absolute top-2.5 right-2.5 rounded-md border border-slate-700/80 bg-slate-950/80 px-2 py-1 font-mono text-[10px] text-slate-200 opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100">
                  Expand ⤢
                </span>
              </button>
              {item.caption && (
                <figcaption class="border-t border-slate-800/80 px-3 py-2 font-mono text-[11px] text-slate-300">
                  {item.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    )}

    {/* 3. Landscape Key Art & Feature Banners */}
    {landscapeItems.length > 0 && (
      <div class="space-y-3">
        <h3 class="font-mono text-xs uppercase tracking-wider text-slate-400">
          Key Art & Feature Highlights
        </h3>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {landscapeItems.map((item) => (
            <figure class="group relative flex flex-col overflow-hidden rounded-xl border border-slate-800 bg-slate-900/50 transition-all hover:border-cyan-500/50 hover:bg-slate-900/90">
              <button
                type="button"
                class="media-lightbox-trigger relative block w-full overflow-hidden bg-slate-950 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
                data-full-src={item.src}
                data-full-alt={item.alt}
                data-full-caption={item.caption ?? item.alt}
                aria-label={`View full size image: ${item.caption ?? item.alt}`}
              >
                <img
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
                <span class="pointer-events-none absolute top-2.5 right-2.5 rounded-md border border-slate-700/80 bg-slate-950/80 px-2 py-1 font-mono text-[10px] text-slate-200 opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100">
                  Expand ⤢
                </span>
              </button>
              {item.caption && (
                <figcaption class="border-t border-slate-800/80 px-3.5 py-2.5 font-mono text-xs text-slate-300">
                  {item.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    )}

    {/* Accessible Native Dialog Lightbox */}
    <dialog
      id="project-media-lightbox"
      class="m-auto max-h-[92vh] max-w-[92vw] rounded-2xl border border-slate-700 bg-slate-950 p-0 text-slate-100 shadow-2xl backdrop:bg-slate-950/85 backdrop:backdrop-blur-xs"
      aria-label="Full size screenshot viewer"
    >
      <div class="flex flex-col max-h-[90vh]">
        <div class="flex items-center justify-between gap-4 border-b border-slate-800 bg-slate-900 px-4 py-3">
          <span
            id="lightbox-caption"
            class="font-mono text-xs font-medium text-slate-200 truncate"
          ></span>
          <button
            type="button"
            id="lightbox-close"
            class="rounded-lg border border-slate-700 bg-slate-800 px-2.5 py-1 font-mono text-xs text-slate-200 hover:border-cyan-400 hover:text-cyan-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
          >
            Close [ESC]
          </button>
        </div>
        <div class="flex items-center justify-center overflow-auto p-4 bg-slate-950">
          <img
            id="lightbox-image"
            src=""
            alt=""
            class="max-h-[78vh] w-auto rounded-lg object-contain"
          />
        </div>
      </div>
    </dialog>
  </section>
)}

<script>
  const dialog = document.getElementById('project-media-lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const closeBtn = document.getElementById('lightbox-close');
  const triggers = document.querySelectorAll<HTMLButtonElement>('.media-lightbox-trigger');

  if (dialog && lightboxImg && lightboxCaption) {
    triggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-full-src') ?? '';
        const alt = btn.getAttribute('data-full-alt') ?? '';
        const caption = btn.getAttribute('data-full-caption') ?? '';

        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightboxCaption.textContent = caption;
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  }
</script>
