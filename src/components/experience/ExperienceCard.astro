---
import type { WorkExperience } from '../../data/experience';
import { localizePath, resolveLocale } from '../../i18n';
import { getUI } from '../../i18n/ui';

interface Props {
  experience: WorkExperience;
}

const { experience } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
---

<article class="relative flex flex-col justify-between rounded-xl border border-slate-800 bg-slate-900/50 p-6 sm:p-8 space-y-6 transition hover:border-slate-700 hover:bg-slate-900/70">
  <div class="space-y-4">
    <!-- Top row: Title, Company, Period -->
    <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-baseline">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-100">
          {experience.role}
        </h3>
        <p class="font-mono text-sm font-medium text-cyan-400 mt-0.5">
          {experience.company} • <span class="text-slate-400">{experience.location}</span>
          {experience.remote && (
            <span class="ml-1.5 rounded bg-slate-800/80 px-2 py-0.5 text-[11px] text-slate-300 border border-slate-700/60">
              {ui.experienceCard.remote}
            </span>
          )}
        </p>
      </div>

      <span class="inline-flex items-center rounded-full border border-slate-700 bg-slate-800 px-3 py-1 font-mono text-xs text-slate-200">
        {experience.period.start} — {experience.period.end}
      </span>
    </div>

    <!-- Summary -->
    <p class="text-slate-300 text-sm leading-relaxed">{experience.shortSummary}</p>

    <!-- Detailed Responsibilities -->
    <div class="space-y-2 pt-2">
      <span class="font-mono text-xs uppercase tracking-wider text-slate-400 font-semibold block">
        {ui.experienceCard.technicalOwnership}
      </span>
      <ul class="space-y-1.5 text-xs text-slate-300">
        {experience.responsibilities.map((resp) => (
          <li class="flex items-start gap-2">
            <span class="text-cyan-400 mt-0.5">▹</span>
            <span class="leading-relaxed">{resp}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Leadership & Mentoring Highlights -->
    {experience.leadershipAndMentoring.length > 0 && (
      <div class="space-y-2 pt-2">
        <span class="font-mono text-xs uppercase tracking-wider text-emerald-400 font-semibold block">
          {ui.experienceCard.leadershipMentoring}
        </span>
        <ul class="space-y-1.5 text-xs text-slate-300">
          {experience.leadershipAndMentoring.map((lead) => (
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 mt-0.5">•</span>
              <span class="leading-relaxed">{lead}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Footer: Tech Stack & Linked Projects -->
  <div class="pt-4 border-t border-slate-800/80 space-y-4">
    <div class="flex flex-wrap gap-1.5 font-mono text-xs">
      {experience.technologiesUsed.map((tech) => (
        <span class="rounded bg-slate-950/80 px-2 py-0.5 text-slate-300 border border-slate-800">
          {tech}
        </span>
      ))}
    </div>

    {experience.projectsLinked && experience.projectsLinked.length > 0 && (
      <div class="flex items-center gap-2 font-mono text-xs text-slate-400">
        <span>{ui.experienceCard.linkedProjects}</span>
        {experience.projectsLinked.map((proj) => (
          <a
            href={localizePath(`/projects/${proj}`, locale)}
            class="text-cyan-400 hover:underline hover:text-cyan-300 capitalize"
          >
            {proj.replace(/-/g, ' ')} →
          </a>
        ))}
      </div>
    )}
  </div>
</article>
