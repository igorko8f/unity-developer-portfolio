---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceCard from '../experience/ExperienceCard.astro';
import { getWorkExperience, getEducation, getLanguages } from '../../data/experience';
import { getSkillCategories, getSkillTierMeta } from '../../data/skills';
import { localizePath, resolveLocale } from '../../i18n';
import { getUI } from '../../i18n/ui';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
const experiences = getWorkExperience(locale);
const education = getEducation(locale);
const languages = getLanguages(locale);
const skillTierMeta = getSkillTierMeta(locale);
const skillCategories = getSkillCategories(locale);

const pillarTitleClasses: Record<'cyan' | 'emerald' | 'purple' | 'amber', string> = {
  cyan: 'text-cyan-400',
  emerald: 'text-emerald-400',
  purple: 'text-purple-400',
  amber: 'text-amber-400',
};
---

<BaseLayout title={ui.experiencePage.metaTitle} description={ui.experiencePage.metaDescription}>
  <div class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-20">
      <!-- Page Header -->
      <header class="flex flex-col justify-between gap-6 border-b border-slate-800 pb-10 sm:flex-row sm:items-end">
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-cyan-400">
            <span>{ui.experiencePage.eyebrow}</span>
          </div>
          <h1 class="text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl">
            {ui.experiencePage.heading}
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed">{ui.experiencePage.description}</p>
        </div>

        <a
          href={localizePath('/cv', locale)}
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-cyan-500 px-5 py-2.5 font-mono text-sm font-semibold text-slate-950 transition hover:bg-cyan-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 shrink-0"
        >
          {ui.experiencePage.viewPrintableCv}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>
      </header>

      <!-- 1. Chronological Experience Section -->
      <section class="space-y-8" aria-labelledby="timeline-heading">
        <div class="space-y-2 border-b border-slate-800 pb-4">
          <span class="font-mono text-xs uppercase tracking-wider text-cyan-400">
            {ui.experiencePage.section01Eyebrow}
          </span>
          <h2 id="timeline-heading" class="text-2xl sm:text-3xl font-bold text-slate-100">
            {ui.experiencePage.section01Heading}
          </h2>
        </div>

        <div class="space-y-8">
          {experiences.map((exp) => (
            <ExperienceCard experience={exp} />
          ))}
        </div>
      </section>

      <!-- 2. Leadership & Engineering Philosophy -->
      <section
        class="rounded-2xl border border-slate-800 bg-slate-900/30 p-6 sm:p-8 lg:p-10 space-y-8"
        aria-labelledby="leadership-heading"
      >
        <div class="max-w-2xl space-y-2">
          <span class="font-mono text-xs uppercase tracking-wider text-emerald-400">
            {ui.experiencePage.section02Eyebrow}
          </span>
          <h2 id="leadership-heading" class="text-2xl sm:text-3xl font-bold text-slate-100">
            {ui.experiencePage.section02Heading}
          </h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            {ui.experiencePage.section02Description}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {ui.experiencePage.leadershipPillars.map((pillar) => (
            <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-5 space-y-2.5">
              <span
                class={`font-mono text-xs font-semibold block ${pillarTitleClasses[pillar.color]}`}
              >
                {pillar.title}
              </span>
              <p class="text-xs text-slate-300 leading-relaxed">{pillar.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. Comprehensive Technical Skills Matrix -->
      <section class="space-y-8" aria-labelledby="skills-heading">
        <div class="space-y-2 border-b border-slate-800 pb-4">
          <span class="font-mono text-xs uppercase tracking-wider text-cyan-400">
            {ui.experiencePage.section03Eyebrow}
          </span>
          <h2 id="skills-heading" class="text-2xl sm:text-3xl font-bold text-slate-100">
            {ui.experiencePage.section03Heading}
          </h2>
          <p class="text-sm text-slate-400">{ui.experiencePage.section03Description}</p>

          <!-- Tier Legend -->
          <div class="flex flex-wrap gap-3 pt-2">
            {Object.values(skillTierMeta).map((tierMeta) => (
              <div class="inline-flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-900/60 px-3 py-1.5 text-xs">
                <span
                  class={`font-mono text-[11px] rounded px-2 py-0.5 border ${tierMeta.badgeClasses}`}
                >
                  {tierMeta.label}
                </span>
                <span class="text-slate-400 hidden sm:inline">{tierMeta.description}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          {skillCategories.map((cat) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 sm:p-7 space-y-4">
              <div>
                <h3 class="text-lg font-bold text-slate-100">{cat.title}</h3>
                <p class="text-xs text-slate-400 mt-1">{cat.shortDescription}</p>
              </div>

              <div class="space-y-2 pt-2 border-t border-slate-800/80">
                {cat.skills.map((skill) => {
                  const tierInfo = skillTierMeta[skill.tier];
                  return (
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs py-1.5 border-b border-slate-800/40 last:border-0">
                      <span
                        class={skill.highlight ? 'font-semibold text-slate-100' : 'text-slate-300'}
                      >
                        {skill.name}
                      </span>

                      <span
                        class={`font-mono text-[11px] rounded px-2 py-0.5 border shrink-0 ${tierInfo.badgeClasses}`}
                      >
                        {tierInfo.label}
                      </span>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Education & Languages Section -->
      <section class="space-y-8" aria-labelledby="education-heading">
        <div class="space-y-2 border-b border-slate-800 pb-4">
          <span class="font-mono text-xs uppercase tracking-wider text-cyan-400">
            {ui.experiencePage.section04Eyebrow}
          </span>
          <h2 id="education-heading" class="text-2xl sm:text-3xl font-bold text-slate-100">
            {ui.experiencePage.section04Heading}
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <!-- Education Card -->
          <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 sm:p-7 space-y-4">
            <div>
              <span class="font-mono text-xs font-semibold text-cyan-400 block uppercase tracking-wider">
                {ui.experiencePage.formalDegree}
              </span>
              <h3 class="text-xl font-bold text-slate-100 mt-1">{education.institution}</h3>
            </div>
            <div class="space-y-1 text-sm text-slate-300">
              <p class="font-medium text-slate-200">
                {education.degree} — {education.field}
              </p>
              <p class="font-mono text-xs text-slate-400">
                {ui.experiencePage.completedPrefix} {education.graduationDate} •{' '}
                {education.location}
              </p>
            </div>
          </div>

          <!-- Languages Card -->
          <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 sm:p-7 space-y-4">
            <div>
              <span class="font-mono text-xs font-semibold text-emerald-400 block uppercase tracking-wider">
                {ui.experiencePage.languageProficiencies}
              </span>
              <h3 class="text-xl font-bold text-slate-100 mt-1">
                {ui.experiencePage.spokenWritten}
              </h3>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 pt-1">
              {languages.map((lang) => (
                <div class="rounded-lg border border-slate-800 bg-slate-950/80 p-3.5 space-y-1">
                  <span class="font-semibold text-slate-200 text-sm block">{lang.language}</span>
                  <span class="font-mono text-xs text-cyan-400 block">{lang.proficiency}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
