---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, resolveLocale } from '../i18n';
import { getUI } from '../i18n/ui';

const locale = resolveLocale(Astro.currentLocale);
const ui = getUI(locale);
---

<BaseLayout title={ui.notFound.metaTitle} description={ui.notFound.metaDescription}>
  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-xl text-center px-4 sm:px-6 space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-red-500/30 bg-red-950/40 px-3 py-1 font-mono text-xs text-red-400">
        <span>{ui.notFound.badge}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-100">
        {ui.notFound.heading}
      </h1>

      <p class="text-slate-400 text-sm leading-relaxed sm:text-base">{ui.notFound.description}</p>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a
          href={localizePath('/', locale)}
          class="rounded-lg bg-cyan-500 px-5 py-2.5 font-mono text-xs font-semibold text-slate-950 hover:bg-cyan-400 transition"
        >
          {ui.notFound.returnHome}
        </a>
        <a
          href={localizePath('/projects', locale)}
          class="rounded-lg border border-slate-700 bg-slate-900 px-5 py-2.5 font-mono text-xs font-medium text-slate-200 hover:border-slate-500 transition"
        >
          {ui.notFound.exploreProjects}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
