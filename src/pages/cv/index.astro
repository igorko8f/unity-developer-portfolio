---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_META } from '../../data/site-meta';
import { WORK_EXPERIENCE, EDUCATION, LANGUAGES } from '../../data/experience';
import { getAllProjects } from '../../utils/projects';

const projects = await getAllProjects();
---

<BaseLayout
  title={`CV / Resume — ${SITE_META.developerName} | Senior Unity Developer`}
  description="Printable resume of Igor Coseanic, Senior / Lead Unity Developer with 6+ years of commercial game engineering, backend integration, and architecture experience."
>
  <!-- Print Controls Banner (Screen Only) -->
  <div class="no-print border-b border-slate-800 bg-slate-900/80 py-4 backdrop-blur-md sticky top-16 z-30">
    <div class="mx-auto flex max-w-4xl items-center justify-between px-4 sm:px-6">
      <div class="flex items-center gap-2 text-xs font-mono text-slate-300">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        <span>Print-Optimized Resume View</span>
      </div>

      <div class="flex items-center gap-3">
        <button
          id="print-cv-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg bg-cyan-500 px-4 py-2 font-mono text-xs font-semibold text-slate-950 transition hover:bg-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-400"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
            />
          </svg>
          <span>Print / Save as PDF</span>
        </button>

        <a
          href="/experience"
          class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 font-mono text-xs text-slate-300 hover:text-slate-100 transition"
        >
          Back to Timeline
        </a>
      </div>
    </div>
  </div>

  <!-- Resume Sheet Container -->
  <div class="py-12 sm:py-16">
    <div
      id="resume-document"
      class="resume-sheet mx-auto max-w-4xl rounded-2xl border border-slate-800 bg-slate-900/60 p-8 sm:p-12 space-y-10 shadow-2xl transition"
    >
      <!-- Resume Header -->
      <header class="border-b border-slate-800 pb-8 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
          <div class="flex items-center gap-5">
            <div class="relative h-20 w-20 sm:h-24 sm:w-24 shrink-0 overflow-hidden rounded-full border-2 border-slate-700 ring-2 ring-cyan-500/30 shadow-xl print:border-slate-400 print:ring-0">
              <img
                src="/images/avatar.webp"
                alt="Igor Coseanic photo"
                width="96"
                height="96"
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
            <div>
              <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-100 resume-title">
                {SITE_META.developerName}
              </h1>
              <p class="font-mono text-sm sm:text-base text-cyan-400 mt-0.5 font-semibold">
                Senior / Lead Unity Developer
              </p>
              <span class="inline-block font-mono text-xs font-semibold text-emerald-400 mt-1">
                6+ Years Commercial Experience
              </span>
            </div>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-300">
          Specialized in Gameplay Systems, Mobile Performance Optimization, Unity Architecture, SDK
          Integration & Technical Leadership
        </p>

        <!-- Contact & Meta Strip -->
        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 pt-2 font-mono text-xs text-slate-400 resume-contact">
          <a
            href={`mailto:${SITE_META.email}`}
            class="text-slate-300 hover:text-cyan-400 transition-colors"
          >
            {SITE_META.email}
          </a>
          {SITE_META.phone && (
            <>
              <span>•</span>
              <a
                href={`tel:${SITE_META.phone}`}
                class="text-slate-300 hover:text-cyan-400 transition-colors"
              >
                {SITE_META.phone}
              </a>
            </>
          )}
          {SITE_META.location && (
            <>
              <span>•</span>
              <span class="text-slate-300">{SITE_META.location}</span>
            </>
          )}
          <span>•</span>
          <a
            href="https://www.linkedin.com/in/igor-coseanic-unity"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 hover:text-cyan-400 transition-colors"
          >
            linkedin.com/in/igor-coseanic-unity
          </a>
          <span>•</span>
          <a
            href="https://github.com/igorko8f"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 hover:text-cyan-400 transition-colors"
          >
            github.com/igorko8f
          </a>
        </div>
      </header>

      <!-- Executive Profile Summary -->
      <section class="space-y-3">
        <h2 class="font-mono text-xs uppercase tracking-wider text-cyan-400 font-bold section-title">
          Professional Summary
        </h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          Senior Unity Developer with 6+ years of experience building mobile, Web, and PC games.
          Specialized in gameplay systems, performance optimization, Unity architecture, and SDK
          integration, with recent experience leading development teams and driving technical
          decisions. Proven track record engineering and maintaining live titles with 1M+ downloads,
          deep Firebase infrastructure, custom telemetry pipelines, pure C# decoupled domains, and
          continuous LiveOps.
        </p>
      </section>

      <!-- Core Competencies Matrix -->
      <section class="space-y-3">
        <h2 class="font-mono text-xs uppercase tracking-wider text-cyan-400 font-bold section-title">
          Core Technical Competencies & Skills
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
          <div class="space-y-1">
            <span class="font-semibold text-slate-200">Unity & C# Core:</span>
            <p class="text-slate-400">
              Unity 6, Mobile 2D/3D Lifecycle, C#, URP, GC Elimination, Memory Profiler, Target 60
              FPS, Addressables.
            </p>
          </div>
          <div class="space-y-1">
            <span class="font-semibold text-slate-200">Software Architecture:</span>
            <p class="text-slate-400">
              SOLID, OOP, MVX Patterns, HMVC, ECS, Entitas, ScriptableObjects, Component-Based
              Systems.
            </p>
          </div>
          <div class="space-y-1">
            <span class="font-semibold text-slate-200">Frameworks & DI:</span>
            <p class="text-slate-400">
              Zenject / Extenject, Dependency Injection, UniRx / R3, UniTask, DOTween, Async
              Workflows.
            </p>
          </div>
          <div class="space-y-1">
            <span class="font-semibold text-slate-200">Backend & Analytics:</span>
            <p class="text-slate-400">
              Firebase (RTDB, Firestore, Auth, Analytics), REST APIs, LookerStudio, Google Cloud,
              AppsFlyer, Unity IAP, A/B Testing, Offline Caching.
            </p>
          </div>
          <div class="space-y-1">
            <span class="font-semibold text-slate-200">Quality & DevOps:</span>
            <p class="text-slate-400">
              Git, GitFlow, CI/CD, AltTester Automated Testing, PlayMode Tests, Code Reviews &
              Technical Mentorship.
            </p>
          </div>
          <div class="space-y-1">
            <span class="font-semibold text-slate-200">AI-Augmented Engineering:</span>
            <p class="text-slate-400">
              Agent Context Engineering (AGENTS.md), Task Decomposition, Human-in-the-Loop Quality
              Verification.
            </p>
          </div>
        </div>
      </section>

      <!-- Commercial Work Experience -->
      <section class="space-y-6">
        <h2 class="font-mono text-xs uppercase tracking-wider text-cyan-400 font-bold section-title">
          Professional Work History
        </h2>

        <div class="space-y-6">
          {WORK_EXPERIENCE.map((exp) => (
            <div class="space-y-2 border-l-2 border-slate-800 pl-4 print:border-slate-300">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="font-bold text-slate-100 text-base">
                  {exp.role} <span class="font-normal text-slate-400">— {exp.company}</span>
                </h3>
                <span class="font-mono text-xs text-slate-400">
                  {exp.period.start} — {exp.period.end} ({exp.location}
                  {exp.remote ? ' • Remote' : ''})
                </span>
              </div>

              <p class="text-xs text-slate-300 italic">{exp.shortSummary}</p>

              <ul class="space-y-1 text-xs text-slate-400 pt-1">
                {exp.responsibilities.map((resp) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-cyan-400 mt-0.5">•</span>
                    <span>{resp}</span>
                  </li>
                ))}
                {exp.leadershipAndMentoring.map((lead) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-emerald-400 mt-0.5">•</span>
                    <span>{lead}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Live Shipped Products (from CV) -->
      <section class="space-y-4">
        <h2 class="font-mono text-xs uppercase tracking-wider text-cyan-400 font-bold section-title">
          Live Shipped Products & Key Highlights
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <div class="rounded-lg border border-slate-800 p-3.5 space-y-1.5 bg-slate-950/60 print:border-slate-300 print:bg-transparent">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-100">Jolly Match 3</h3>
              <span class="font-mono text-[10px] text-emerald-400 font-semibold">
                100k+ Downloads
              </span>
            </div>
            <p class="text-[11px] text-slate-400 font-mono">iOS & Android • Team of 12 (4 Devs)</p>
            <p class="text-slate-400 text-[11px] leading-relaxed">
              Senior/Lead Unity Developer. Gameplay systems, monetization, analytics integration,
              Firebase, A/B testing, performance optimization, and roadmap planning.
            </p>
          </div>

          <div class="rounded-lg border border-slate-800 p-3.5 space-y-1.5 bg-slate-950/60 print:border-slate-300 print:bg-transparent">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-100">Jolly Battle</h3>
              <span class="font-mono text-[10px] text-emerald-400 font-semibold">
                1M+ Downloads
              </span>
            </div>
            <p class="text-[11px] text-slate-400 font-mono">iOS & Android • Core Team of 2</p>
            <p class="text-slate-400 text-[11px] leading-relaxed">
              Competitive multiplayer battles. Long-term product support, new features, Firebase
              services, monetization SDKs, A/B testing, and stability improvements.
            </p>
          </div>

          <div class="rounded-lg border border-slate-800 p-3.5 space-y-1.5 bg-slate-950/60 print:border-slate-300 print:bg-transparent">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-100">Jigsaw Puzzle</h3>
              <span class="font-mono text-[10px] text-cyan-400 font-semibold">Live on Stores</span>
            </div>
            <p class="text-[11px] text-slate-400 font-mono">iOS & Android • Team of 7 (2 Devs)</p>
            <p class="text-slate-400 text-[11px] leading-relaxed">
              Jigsaw puzzle title by Jolly Battle. Gameplay mechanics, analytics, monetization,
              Firebase services, A/B testing, code reviews, and performance tuning.
            </p>
          </div>
        </div>
      </section>

      <!-- Key Project Case Studies -->
      <section class="space-y-4">
        <h2 class="font-mono text-xs uppercase tracking-wider text-cyan-400 font-bold section-title">
          Selected Project Case Studies
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          {projects.map((proj) => (
            <div class="rounded-lg border border-slate-800 p-3.5 space-y-1.5 bg-slate-950/60 print:border-slate-300 print:bg-transparent">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-slate-100">{proj.data.title}</h3>
                <span class="font-mono text-[10px] text-slate-400">
                  {proj.data.platforms.join(', ')}
                </span>
              </div>
              <p class="text-slate-400 text-[11px] leading-relaxed">{proj.data.shortDescription}</p>
              <div class="font-mono text-[10px] text-cyan-400">
                {proj.data.technologies.slice(0, 4).join(' • ')}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education & Languages -->
      <section class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
        <!-- Education -->
        <div class="space-y-3">
          <h2 class="font-mono text-xs uppercase tracking-wider text-cyan-400 font-bold section-title">
            Education
          </h2>
          <div class="space-y-1 text-xs">
            <h3 class="font-bold text-slate-100">{EDUCATION.institution}</h3>
            <p class="text-slate-300 font-medium">
              {EDUCATION.degree}, {EDUCATION.field}
            </p>
            <p class="font-mono text-[11px] text-slate-400">
              {EDUCATION.graduationDate} | {EDUCATION.location}
            </p>
          </div>
        </div>

        <!-- Languages -->
        <div class="space-y-3">
          <h2 class="font-mono text-xs uppercase tracking-wider text-cyan-400 font-bold section-title">
            Languages
          </h2>
          <div class="flex flex-wrap gap-2 text-xs">
            {LANGUAGES.map((lang) => (
              <div class="rounded-lg border border-slate-800 bg-slate-950/60 px-3 py-1.5 print:border-slate-300">
                <span class="font-semibold text-slate-200">{lang.language}:</span>{' '}
                <span class="text-slate-400 font-mono">{lang.proficiency}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  @media print {
    :global(html),
    :global(body) {
      background: #ffffff !important;
      color: #0f172a !important;
    }

    :global(body > header),
    :global(body > footer),
    .no-print {
      display: none !important;
    }

    .resume-sheet {
      border: none !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
      max-width: 100% !important;
      color: #0f172a !important;
    }

    .resume-title,
    h2,
    h3,
    h4 {
      color: #0f172a !important;
    }

    .resume-contact a,
    .resume-contact span,
    p,
    li,
    span {
      color: #1e293b !important;
    }

    .section-title {
      color: #0369a1 !important;
      border-bottom: 1px solid #cbd5e1 !important;
      padding-bottom: 4px;
    }
  }
</style>

<script>
  const printBtn = document.getElementById('print-cv-btn');
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print();
    });
  }
</script>
