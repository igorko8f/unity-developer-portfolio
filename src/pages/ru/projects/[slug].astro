---
import { render } from 'astro:content';
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import { getAllProjects, getProjectSlug, type ProjectEntry } from '../../../utils/projects';

export async function getStaticPaths() {
  const projects = await getAllProjects('ru');

  return projects.map((project, index) => {
    const prevProject = index > 0 ? projects[index - 1] : undefined;
    const nextProject = index < projects.length - 1 ? projects[index + 1] : undefined;

    return {
      params: { slug: getProjectSlug(project) },
      props: { project, prevProject, nextProject },
    };
  });
}

interface Props {
  project: ProjectEntry;
  prevProject?: ProjectEntry;
  nextProject?: ProjectEntry;
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);
---

<ProjectLayout project={project} prevProject={prevProject} nextProject={nextProject}>
  <Content />
</ProjectLayout>
