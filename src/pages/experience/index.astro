---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceCard from '../../components/experience/ExperienceCard.astro';
import { WORK_EXPERIENCE, EDUCATION, LANGUAGES } from '../../data/experience';
import { SKILL_CATEGORIES, SKILL_TIER_META } from '../../data/skills';
---

<BaseLayout
  title="Experience & Leadership | Senior Unity Developer"
  description="Career timeline, systems ownership, technical leadership, code review standards, and comprehensive skills matrix of a Senior / Lead Unity Developer."
>
  <div class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-20">
      <!-- Page Header -->
      <header class="flex flex-col justify-between gap-6 border-b border-slate-800 pb-10 sm:flex-row sm:items-end">
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-cyan-400">
            <span>Career History</span>
          </div>
          <h1 class="text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl">
            Professional Experience & Leadership
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed">
            6+ years of commercial game engineering experience. Demonstrating end-to-end systems
            ownership, backend telemetry pipelines, mobile optimization, and engineering team
            mentorship.
          </p>
        </div>

        <a
          href="/cv"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-cyan-500 px-5 py-2.5 font-mono text-sm font-semibold text-slate-950 transition hover:bg-cyan-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 shrink-0"
        >
          View Printable CV
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>
      </header>

      <!-- 1. Chronological Experience Section -->
      <section class="space-y-8" aria-labelledby="timeline-heading">
        <div class="space-y-2 border-b border-slate-800 pb-4">
          <span class="font-mono text-xs uppercase tracking-wider text-cyan-400">
            01 / Work History
          </span>
          <h2 id="timeline-heading" class="text-2xl sm:text-3xl font-bold text-slate-100">
            Career Timeline
          </h2>
        </div>

        <div class="space-y-8">
          {WORK_EXPERIENCE.map((exp) => (
            <ExperienceCard experience={exp} />
          ))}
        </div>
      </section>

      <!-- 2. Leadership & Engineering Philosophy -->
      <section
        class="rounded-2xl border border-slate-800 bg-slate-900/30 p-6 sm:p-8 lg:p-10 space-y-8"
        aria-labelledby="leadership-heading"
      >
        <div class="max-w-2xl space-y-2">
          <span class="font-mono text-xs uppercase tracking-wider text-emerald-400">
            02 / Engineering Culture
          </span>
          <h2 id="leadership-heading" class="text-2xl sm:text-3xl font-bold text-slate-100">
            Leadership & Mentorship Philosophy
          </h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Technical seniority means multiplying the effectiveness of the entire team through clear
            architectural guidelines, robust tooling, and constructive mentorship.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-5 space-y-2.5">
            <span class="font-mono text-xs font-semibold text-cyan-400 block">
              Code Reviews as Mentorship
            </span>
            <p class="text-xs text-slate-300 leading-relaxed">
              Reviews are learning opportunities: catching allocation spikes and memory leaks early
              while coaching mid and junior engineers on C# design patterns.
            </p>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-5 space-y-2.5">
            <span class="font-mono text-xs font-semibold text-emerald-400 block">
              Client-Server API Contracts
            </span>
            <p class="text-xs text-slate-300 leading-relaxed">
              Bridging the gap between game clients and server teams by defining clear REST/JSON
              contracts, JWT authentication flows, and retry safeguards.
            </p>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-5 space-y-2.5">
            <span class="font-mono text-xs font-semibold text-purple-400 block">
              Automated Quality & CI/CD
            </span>
            <p class="text-xs text-slate-300 leading-relaxed">
              Shifting QA left by implementing automated regression suites with AltTester and
              PlayMode tests, integrated into continuous build pipelines.
            </p>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-5 space-y-2.5">
            <span class="font-mono text-xs font-semibold text-amber-400 block">
              Context & Documentation
            </span>
            <p class="text-xs text-slate-300 leading-relaxed">
              Maintaining concise technical documentation, architecture RFCs, and agent rulefiles
              (AGENTS.md) to keep team standards aligned.
            </p>
          </div>
        </div>
      </section>

      <!-- 3. Comprehensive Technical Skills Matrix -->
      <section class="space-y-8" aria-labelledby="skills-heading">
        <div class="space-y-2 border-b border-slate-800 pb-4">
          <span class="font-mono text-xs uppercase tracking-wider text-cyan-400">
            03 / Competency Matrix
          </span>
          <h2 id="skills-heading" class="text-2xl sm:text-3xl font-bold text-slate-100">
            Technical Stack & Proficiency
          </h2>
          <p class="text-sm text-slate-400">
            Technologies clearly separated between commercial production experience, independent
            projects, and active exploration.
          </p>

          <!-- Tier Legend -->
          <div class="flex flex-wrap gap-3 pt-2">
            {Object.values(SKILL_TIER_META).map((tierMeta) => (
              <div class="inline-flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-900/60 px-3 py-1.5 text-xs">
                <span
                  class={`font-mono text-[11px] rounded px-2 py-0.5 border ${tierMeta.badgeClasses}`}
                >
                  {tierMeta.label}
                </span>
                <span class="text-slate-400 hidden sm:inline">{tierMeta.description}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          {SKILL_CATEGORIES.map((cat) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 sm:p-7 space-y-4">
              <div>
                <h3 class="text-lg font-bold text-slate-100">{cat.title}</h3>
                <p class="text-xs text-slate-400 mt-1">{cat.shortDescription}</p>
              </div>

              <div class="space-y-2 pt-2 border-t border-slate-800/80">
                {cat.skills.map((skill) => {
                  const tierInfo = SKILL_TIER_META[skill.tier];
                  return (
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs py-1.5 border-b border-slate-800/40 last:border-0">
                      <span
                        class={skill.highlight ? 'font-semibold text-slate-100' : 'text-slate-300'}
                      >
                        {skill.name}
                      </span>

                      <span
                        class={`font-mono text-[11px] rounded px-2 py-0.5 border shrink-0 ${tierInfo.badgeClasses}`}
                      >
                        {tierInfo.label}
                      </span>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Education & Languages Section -->
      <section class="space-y-8" aria-labelledby="education-heading">
        <div class="space-y-2 border-b border-slate-800 pb-4">
          <span class="font-mono text-xs uppercase tracking-wider text-cyan-400">
            04 / Background & Education
          </span>
          <h2 id="education-heading" class="text-2xl sm:text-3xl font-bold text-slate-100">
            Education & Languages
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <!-- Education Card -->
          <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 sm:p-7 space-y-4">
            <div>
              <span class="font-mono text-xs font-semibold text-cyan-400 block uppercase tracking-wider">
                Formal Academic Degree
              </span>
              <h3 class="text-xl font-bold text-slate-100 mt-1">{EDUCATION.institution}</h3>
            </div>
            <div class="space-y-1 text-sm text-slate-300">
              <p class="font-medium text-slate-200">
                {EDUCATION.degree} — {EDUCATION.field}
              </p>
              <p class="font-mono text-xs text-slate-400">
                Completed {EDUCATION.graduationDate} • {EDUCATION.location}
              </p>
            </div>
          </div>

          <!-- Languages Card -->
          <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 sm:p-7 space-y-4">
            <div>
              <span class="font-mono text-xs font-semibold text-emerald-400 block uppercase tracking-wider">
                Language Proficiencies
              </span>
              <h3 class="text-xl font-bold text-slate-100 mt-1">Spoken & Written Languages</h3>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 pt-1">
              {LANGUAGES.map((lang) => (
                <div class="rounded-lg border border-slate-800 bg-slate-950/80 p-3.5 space-y-1">
                  <span class="font-semibold text-slate-200 text-sm block">{lang.language}</span>
                  <span class="font-mono text-xs text-cyan-400 block">{lang.proficiency}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
